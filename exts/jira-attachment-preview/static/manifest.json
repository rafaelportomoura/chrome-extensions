{
  "manifest_version": 3,
  "name": "Attachment Preview for Jira",
  "version": "1.1.0",
  "description": "Renders HTML and Markdown attachments inside the Jira Cloud attachment viewer.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.atlassian.net/*"],
      "js": ["page.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "sandbox": {
    "pages": ["preview.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:"
  },
  "web_accessible_resources": [
    {
      "resources": ["preview.html", "preview.js", "preview.css"],
      "matches": ["https://*.atlassian.net/*"]
    }
  ]
}
