#!/usr/bin/env bash
# Blocks the commit when dependencies carry a moderate-or-worse advisory, lint fails or a file is
# not formatted (run `pnpm format` to fix formatting).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "pre-commit: audit"
pnpm audit --audit-level moderate
echo "pre-commit: lint"
pnpm lint
echo "pre-commit: format check"
pnpm format:check
